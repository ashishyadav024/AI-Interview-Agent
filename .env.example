# =====================================================================
# AI Interview Agent - Environment Configuration Template
# =====================================================================

# Frontend API Configuration
VITE_API_URL=http://localhost:8001
VITE_APP_NAME="AI Interview Agent"

# Backend FastAPI Configuration
PORT=8001
HOST=0.0.0.0

# Groq LLM API Key (Required for AI Interview Conductor, Evaluation, and Speech Models)
GROQ_API_KEY=gsk_your_groq_api_key_here
API_KEY_ANALYSIS=gsk_your_groq_api_key_here
API_KEY_QA=gsk_your_groq_api_key_here
API_KEY_QUESTIONS=gsk_your_groq_api_key_here
API_KEY_IMPROVEMENT=gsk_your_groq_api_key_here
API_KEY_IMPROVED_RESUME=gsk_your_groq_api_key_here

# MongoDB Connection (Optional for local persistent storage, falls back to JSON DB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_interview_agent

# Pre-Configured Test Seed Accounts (Built into server for local evaluation)
