# =====================================================================
# AI Interview Agent - Production & Local Environment Template
# =====================================================================

# Environment Mode ("production" or "development")
ENVIRONMENT=production
NODE_ENV=production

# ---------------------------------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------------------------------
# In production on Vercel, set VITE_API_URL to your Render backend URL:
VITE_API_URL=https://ai-interview-agent-n4bf.onrender.com
# WebSocket URL (wss:// for HTTPS deployments)
VITE_WS_URL=wss://ai-interview-agent-n4bf.onrender.com
VITE_APP_NAME="AI Interview Agent"

# ---------------------------------------------------------------------
# Backend Configuration (FastAPI on Render / Cloud Host)
# ---------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
BACKEND_URL=https://ai-interview-agent-n4bf.onrender.com

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
ALLOWED_ORIGINS=https://ai-interview-agent-three-taupe.vercel.app

# Security & Session Authentication
JWT_SECRET=your_strong_random_jwt_secret_here_at_least_32_chars
SESSION_SECRET=your_strong_random_session_secret_here

# ---------------------------------------------------------------------
# AI & Speech Services (Required in Production)
# ---------------------------------------------------------------------
# Groq API Key (Obtain from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
API_KEY_ANALYSIS=gsk_your_groq_api_key_here
API_KEY_QA=gsk_your_groq_api_key_here
API_KEY_QUESTIONS=gsk_your_groq_api_key_here
API_KEY_IMPROVEMENT=gsk_your_groq_api_key_here
API_KEY_IMPROVED_RESUME=gsk_your_groq_api_key_here

# ---------------------------------------------------------------------
# Database Persistence (MongoDB Atlas)
# ---------------------------------------------------------------------
# MongoDB URI (Optional: If omitted or offline, falls back to local JSON store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_interview_agent

# ---------------------------------------------------------------------
# Candidate Interview Link & Application URL
# ---------------------------------------------------------------------
# Used to construct honest, single-use candidate interview links
PUBLIC_APP_URL=https://ai-interview-agent-three-taupe.vercel.app

# ---------------------------------------------------------------------
# Outgoing SMTP Email Service (Invitation Delivery)
# ---------------------------------------------------------------------
# Configure with Gmail, SendGrid, Amazon SES, or Mailgun credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=recruiter@yourdomain.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=recruiter@yourdomain.com
COMPANY_NAME="AI Interview Agent"
